{
  "type": "module",
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prestart": "npm run build",
    "start": "next start",
    "dev": "next dev",
    "dev:storybook": "storybook dev -p 6006",
